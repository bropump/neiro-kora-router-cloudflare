    "format:check": "prettier --check \"src/**/*.ts\" tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "wrangler": "4.145.0"
  }
}
